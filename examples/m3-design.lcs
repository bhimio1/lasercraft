# LaserCraft M3: import, text, groups, nodes, booleans, arrays, headless.
# Run from the repository root:
#   lasercraft-cli script examples/m3-design.lcs
project.rename Coaster set
project.import examples/fixtures/m3-art.svg        # 4 shapes, grouped
project.import examples/fixtures/m3-plate.dxf      # outline, holes, slot
arrange.move_to_bed top-right                      # the plate is selected
group.ungroup 1                                    # split the SVG art
path.weld 2 3                                      # circle and holed square
shape.add_text 10 120 8 examples/fixtures/lctest.ttf "HOLA" @2
shape.add_rect 100 100 30 30 @1
shape.add_ellipse 130 115 10 10 @1
path.subtract 13 14                                # bite out of the square
path.offset 2 round 15                             # cut line around it
shape.add_rect 200 150 20 10 @3
shape.to_path 17
node.move 17 0 2 225 165                           # drag a corner
node.insert 17 0 0                                 # split the top edge
node.to_curve 17 0 0
node.set_handle 17 0 0 1 205 140
shape.add_rect 0 200 10 10 @4
shape.add_rect 15 200 10 10 @4
group.create 18 19
arrange.grid 3 2 5 5 18 19                         # a 3 × 2 tray of pairs
shape.add_ellipse 300 300 5 5 @5
arrange.circular 6 300 280 360 rotate 36
arrange.align top 1 4 12                           # line up on the text
edit.undo
