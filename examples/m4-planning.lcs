# LaserCraft M4: toolpath planning, headless. Run from an empty directory:
#   lasercraft-cli script examples/m4-planning.lcs
#   lasercraft-cli preview m4-planning.lcproj --svg m4-planning.svg
project.rename Name tag
shape.add_rect 10 10 80 30 @1                # outline: cut last, with tabs
shape.add_ellipse 20 25 4 4 @1               # hanging hole: cut first
shape.add_rect 30 15 50 20 @2                # engraved panel
shape.add_line 30 38 80 38 @3                # score line
layer.set 1 name Cut
layer.set 1 speed 8
layer.set 1 max_power 90
layer.set 1 passes 2
layer.set 1 kerf 0.1
layer.set 1 tabs 2
layer.set 1 tab_width 1
layer.set 2 name Engrave
layer.set 2 mode fill
layer.set 2 speed 150
layer.set 2 max_power 35
layer.set 2 interval 0.5
layer.set 2 overscan on
layer.set 3 name Score
layer.set 3 speed 30
layer.set 3 max_power 30
layer.move 1 bottom                          # cut through last
project.save m4-planning.lcproj
