# LaserCraft M2: layers, headless.
#   lasercraft-cli script examples/m2-layers.lcs
project.rename Name tag
shape.add_rect 10 10 80 30 @1                # outline, cut last
shape.add_ellipse 20 25 4 4 @1               # hole
shape.add_rect 30 15 50 20 @2                # engraved panel
shape.add_line 30 38 80 38 @3                # score line
layer.set 1 name Cut
layer.set 1 speed 8
layer.set 1 max_power 90
layer.set 1 passes 2
layer.set 1 air on
layer.set 2 name Engrave
layer.set 2 mode fill
layer.set 2 speed 150
layer.set 2 max_power 35
layer.set 2 interval 254lpi
layer.set 2 overscan on
layer.set 3 name Score
layer.copy_settings 1 3                      # same as Cut ...
layer.set 3 passes 1                         # ... but one pass
layer.set 3 max_power 30
layer.move 1 bottom                          # cut through last
layer.select 3
shape.set_layer 2                            # actually engrave the line
edit.undo                                    # no: keep it on Score
