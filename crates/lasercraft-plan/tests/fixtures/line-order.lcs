# Line mode ordering: holes before their part, nearest neighbour, open
# lines entered at the nearer end, passes. Regenerate the .lcproj with
#   lasercraft-cli script line-order.lcs   (from this directory)
project.rename Line order
project.set_work_area 200 100
shape.add_rect 10 10 60 40 @1                       # 1: part outline
shape.add_polyline closed 20 20 30 20 25 30 @1      # 2: triangle hole
shape.add_rect 50 20 10 10 @1                       # 3: square hole
shape.add_line 150 90 100 90 @1                     # 4: open score line
shape.add_rect 120 10 20 20 @1                      # 5: second part
layer.set 1 name Cut
layer.set 1 speed 20
layer.set 1 max_power 80
layer.set 1 passes 2
project.save line-order.lcproj
